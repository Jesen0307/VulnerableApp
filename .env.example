# Copy to .env and fill in real values. Never commit .env.
# Database passwords (used by application-unsafe.properties)
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=
# PKCS12 keystore password (used by JWTAlgorithmKMS)
KEYSTORE_PASSWORD=
# JWT challenge test vectors (optional overrides, defaults keep tests passing)
JWT_HS256_TOKEN_TO_BE_SIGNED=
JWT_RS256_TOKEN_TO_BE_SIGNED=
JWT_GENERIC_BASE64_ENCODED_PAYLOAD=
# SMTP credentials for local mailpit (optional overrides)
SMTP_USERNAME=
SMTP_PASSWORD=
# Public gist id used by the SSRF LEVEL_5 allowlist (optional override)
GIST_ID_SASANLABS_PROJECTS=
